APP_NAME=car-api-scraper
APP_ENV=development

LOG_LEVEL=DEBUG
LOG_DIR=logs
SQL_LOGGING=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
